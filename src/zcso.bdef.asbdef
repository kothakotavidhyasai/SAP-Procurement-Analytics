projection;
strict ( 2 );
use draft;

define behavior for ZCSO alias SalesOrder
use etag
{
  use create;
  use update;
  use delete;

  use association _Item { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZCSOI alias Item
use etag
{
  use update;
  use delete;

  use association _SalesOrder { with draft; }
}